{
  "provider": "antigravity",
  "request": {"method": "POST", "url": "https://daily-cloudcode-pa.googleapis.com/v1internal:retrieveUserQuotaSummary",
              "header": {"Authorization": "Bearer $TOKEN$", "Content-Type": "application/json", "User-Agent": "antigravity/hub/2.34.0 windows/amd64"},
              "data": "{\"project\": \"{project_id}\"}"},
  "windows": [
    {"pool": "flash", "label": "5h", "path": "groups[*].buckets[*]", "match": {"bucketId": "gemini-5h"}, "remaining": "remainingFraction", "missing": 0, "scale": 1, "reset": "resetTime", "length_s": 18000, "skip_if": "disabled"},
    {"pool": "flash", "label": "7d", "path": "groups[*].buckets[*]", "match": {"bucketId": "gemini-weekly"}, "remaining": "remainingFraction", "missing": 0, "scale": 1, "reset": "resetTime", "length_s": 604800},
    {"pool": "3p", "label": "5h", "path": "groups[*].buckets[*]", "match": {"bucketId": "3p-5h"}, "remaining": "remainingFraction", "missing": 0, "scale": 1, "reset": "resetTime", "length_s": 18000, "skip_if": "disabled", "optional": true},
    {"pool": "3p", "label": "7d", "path": "groups[*].buckets[*]", "match": {"bucketId": "3p-weekly"}, "remaining": "remainingFraction", "missing": 0, "scale": 1, "reset": "resetTime", "length_s": 604800, "optional": true},
    {"pool": "argon", "label": "7d", "path": "groups[*].buckets[*]", "match": {"bucketId": "gemini-argon-wtu-weekly"}, "remaining": "remainingFraction", "missing": 0, "scale": 1, "reset": "resetTime", "length_s": 604800, "optional": true}
  ],
  "tile": {"layout": "multi", "span": 2, "pools": [{"id": "flash", "label": "Neon"}, {"id": "3p", "label": "Claude"}, {"id": "argon", "label": "Argon"}]},
  "cooldown_pools": {"argon": "argon", "gemini-4-neon": "flash", "gemini-4-hydrogen": "flash", "gemini-3.8-flash": "flash"},
  "fallback": "cooldowns",
  "notes": "Verified 2026-11-21 on 2 accounts. Read the daily endpoint first: CPAMC serves Antigravity traffic there; the primary endpoint reports a different quota and does not list Neon. Pool flash is the shared Gemini Models bucket (Gemini 4 Neon, Gemini 4 Hydrogen, Gemini 3.8 Flash), labelled Neon. A missing remainingFraction means 0 (Google drops it when a bucket is spent)."
}
